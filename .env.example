# 1. Supabase (Públicas en cliente)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# 2. Supabase Storage & Administración (PRIVADO - SOLO SERVIDOR)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# 3. Google Gemini API (PRIVADO - SOLO SERVIDOR - NUNCA EXPONER EN CLIENTE)
GEMINI_API_KEY=tu-google-gemini-api-key-aqui

# 4. Resend Transactional Email (PRIVADO - SOLO SERVIDOR - NUNCA EXPONER EN CLIENTE)
RESEND_API_KEY=re_tu_resend_api_key_aqui
RESEND_FROM_EMAIL=Anamnesis <notificaciones@anamnesis.com>

# 5. URL del Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000
